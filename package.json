{
  "name": "brixkit",
  "version": "0.1.0",
  "private": true,
  "description": "Brixkit - Modular SvelteKit building blocks for rapid development",
  "scripts": {
    "dev:basic": "pnpm --filter basic dev",
    "dev:github": "pnpm --filter github-oauth dev",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.1.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
