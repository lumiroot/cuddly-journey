{
	"name": "@brixkit/cli",
	"version": "0.1.0",
	"description": "CLI tool for scaffolding SvelteKit projects with Brixkit components",
	"type": "module",
	"bin": {
		"brixkit": "./dist/index.js"
	},
	"files": [
		"dist",
		"templates"
	],
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsup src/index.ts --format esm --clean --sourcemap",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"commander": "^12.0.0",
		"prompts": "^2.4.2",
		"chalk": "^5.3.0",
		"ora": "^8.0.1",
		"execa": "^9.0.0",
		"fs-extra": "^11.2.0",
		"fast-glob": "^3.3.2",
		"prettier": "^3.1.1"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.0.0",
		"@types/prompts": "^2.4.9",
		"tsup": "^8.0.0",
		"tsx": "^4.7.0",
		"typescript": "^5.7.2"
	}
}
